<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-light">

    <nav class="navbar navbar-dark bg-dark p-3 mb-4">
        <div class="container">
            <span class="navbar-brand">
                <i class="fas fa-user-shield me-2"></i>Admin Panel
            </span>
            <span class="text-white">
                Welcome, 
                <% if (user) { %> <%= user.username %> <% } else { %> Admin <% } %>
            </span>
            <a href="/logout" class="btn btn-sm btn-outline-light">Logout</a>
        </div>
    </nav>

    <div class="container">
        <% if (success_msg && success_msg.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success_msg %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <div class="card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h5 class="card-title mb-0">Leave Requests</h5>
    
    <form action="/admin/dashboard" method="GET" class="d-flex gap-2">
        
        <input type="text" name="search" class="form-control form-select-sm" 
               placeholder="Search user or reason..." 
               value="<%= typeof searchTerm !== 'undefined' ? searchTerm : '' %>">
        
        <select name="status" class="form-select form-select-sm" style="width: 150px;">
            <option value="All" <%= currentStatus === 'All' ? 'selected' : '' %>>All Status</option>
            <option value="Pending" <%= currentStatus === 'Pending' ? 'selected' : '' %>>Pending</option>
            <option value="Approved" <%= currentStatus === 'Approved' ? 'selected' : '' %>>Approved</option>
            <option value="Rejected" <%= currentStatus === 'Rejected' ? 'selected' : '' %>>Rejected</option>
        </select>

        <button type="submit" class="btn btn-sm btn-primary">Search</button>
        
        <% if(typeof searchTerm !== 'undefined' && searchTerm !== '') { %>
            <a href="/admin/dashboard" class="btn btn-sm btn-secondary">Clear</a>
        <% } %>
    </form>
</div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Dates</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (leaves && leaves.length > 0) { %>
                            <% leaves.forEach(function(leave) { %>
                                <tr>
                                    <td class="fw-bold"><%= leave.username %></td>
                                    <td>
                                        <small class="text-muted">
                                            <%= new Date(leave.startDate).toLocaleDateString() %> <i class="fas fa-arrow-right mx-1"></i> <%= new Date(leave.endDate).toLocaleDateString() %>
                                        </small>
                                    </td>
                                    <td><%= leave.reason %></td>
                                    <td>
                                        <% if (leave.status === 'Approved') { %>
                                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Approved</span>
                                        <% } else if (leave.status === 'Rejected') { %>
                                            <span class="badge bg-danger"><i class="fas fa-times me-1"></i>Rejected</span>
                                        <% } else { %>
                                            <span class="badge bg-warning text-dark"><i class="fas fa-clock me-1"></i>Pending</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (leave.status === 'Pending') { %>
                                            <div class="d-flex gap-2">
                                                <form action="/leave/<%= leave._id %>/status" method="POST">
                                                    <input type="hidden" name="status" value="Approved">
                                                    <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                                        <i class="fas fa-check"></i>
                                                    </button>
                                                </form>
                                                <form action="/leave/<%= leave._id %>/status" method="POST">
                                                    <input type="hidden" name="status" value="Rejected">
                                                    <button type="submit" class="btn btn-sm btn-danger" title="Reject">
                                                        <i class="fas fa-times"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        <% } else { %>
                                            <span class="text-muted"><i class="fas fa-lock"></i> Locked</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No leave requests found matching this filter.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (totalPages > 1) { %>
                <nav aria-label="Page navigation" class="mt-3">
                    <ul class="pagination justify-content-center">
                        <li class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/dashboard?page=<%= currentPage - 1 %>&status=<%= currentStatus %>">Previous</a>
                        </li>
                        
                        <% for(let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= currentPage == i ? 'active' : '' %>">
                                <a class="page-link" href="/admin/dashboard?page=<%= i %>&status=<%= currentStatus %>"><%= i %></a>
                            </li>
                        <% } %>

                        <li class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
                            <a class="page-link" href="/admin/dashboard?page=<%= currentPage + 1 %>&status=<%= currentStatus %>">Next</a>
                        </li>
                    </ul>
                </nav>
            <% } %>

        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>